@startuml diagrama_arquitectura
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowColor #555555
skinparam ArrowThickness 1.5

skinparam rectangle {
  BackgroundColor #F8F9FA
  BorderColor #CCCCCC
  BorderThickness 1.5
  RoundCorner 8
  FontSize 12
}

skinparam cloud {
  BackgroundColor #FFF8EC
  BorderColor #C9A96E
  BorderThickness 2
}

skinparam database {
  BackgroundColor #EEF6FF
  BorderColor #4A90D9
  BorderThickness 1.5
}

skinparam node {
  BackgroundColor #F0FAF0
  BorderColor #4CAF50
  BorderThickness 1.5
}

skinparam actor {
  BackgroundColor #FAFAFA
  BorderColor #888888
}

title <size:18><b>Arquitectura del Sistema FABRIC</b></size>\n<size:12>Plataforma Web de Consultoría Oracle Cloud Infrastructure</size>

' ─── ACTORES ────────────────────────────────────────────────
actor "Visitante / Prospecto" as user #FAFAFA
actor "Administrador" as admin #FAFAFA

' ─── CAPA DE PRESENTACIÓN ───────────────────────────────────
package "Capa de Presentación" as frontend_layer #FFF8EC {

  rectangle "**React SPA**\n(Vite 6 + TypeScript 6)\n---\nReact Router DOM v7\nFramer Motion · Spline 3D\ntsParticles · Tailwind CSS 4\nClerk React SDK\nFabricContext (store)" as frontend #FFF8EC

  rectangle "**Vercel CDN**\n(Frontend Deployment)\n---\nEdge Network Global\nSPA Rewrite Rules\nHTTPS / TLS automático" as vercel_cdn #FFF4DC

}

' ─── CAPA DE SERVICIOS / BACKEND ────────────────────────────
package "Capa de Servicios" as backend_layer #F0FAF0 {

  rectangle "**Node.js + Express 5**\n(Backend API)\n---\n19 Controladores\n23 Modelos Mongoose\nCORS · JWT · Webhooks\nHealth Check endpoint" as backend #F0FAF0

  rectangle "**Vercel Serverless**\n(Backend Deployment)\n---\n@vercel/node runtime\nDual routing: /api/* y\n/_/backend/api/*" as vercel_be #DCF5DC

}

' ─── BASE DE DATOS ───────────────────────────────────────────
database "**MongoDB Atlas**\nM0 / M10 Cloud\n---\n23 colecciones\nSSL · Replica Set\nIndexes & TTL" as mongo #EEF6FF

' ─── SERVICIOS EXTERNOS ─────────────────────────────────────
package "Servicios Externos" as external #FEF9EC {

  cloud "**Clerk**\nAuth-as-a-Service\n---\nJWT · Webhooks Svix\nRole Metadata\nSpanish UI / Dark theme" as clerk #FFF3CD

  cloud "**Google Calendar API v3**\nService Account Auth\n---\nSlots 09:00–16:00 MX\nlistEvents · insert\ndelete · timezone" as gcal #E8F5E9

  cloud "**Resend**\nEmail Transaccional\n---\nConfirmación aplicación\nConfirmación Office Hours\nBranded HTML templates" as resend #E3F2FD

  cloud "**OpenAI API**\nGPT (gpt-4o)\n---\nStreaming responses\nConversation history\nOracle diagnostics context" as openai #F3E5F5

  cloud "**DeepL API**\nTraducción ES↔EN\n---\nTranslation cache\n(MongoDB TTL)\n500K chars/mes free" as deepl #FFF9C4

}

' ─── FLUJOS PRINCIPALES ─────────────────────────────────────

user  --> vercel_cdn      : HTTPS\n(browser)
admin --> vercel_cdn      : HTTPS\n(browser)

vercel_cdn --> frontend   : Static assets\n(index.html + JS bundle)

frontend --> vercel_be    : REST API\nHTTPS/JSON\nBearer Token
frontend --> clerk        : Auth flows\n(sign-in / sign-up)

vercel_be --> backend

backend --> mongo         : Mongoose ODM\n(read / write)
backend --> clerk         : Token verification\nClerk SDK Node
backend --> gcal          : Calendar events\n(create / list / delete)
backend --> resend        : Send emails\n(transactional)
backend --> openai        : Chat completions\n(streaming)
backend --> deepl         : Translate text\n(ES ↔ EN)

clerk   --> backend       : Webhooks Svix\n(user.created\nuser.updated\nuser.deleted)

' ─── LEYENDA ────────────────────────────────────────────────
legend bottom right
  |= Color |= Capa |
  |<#FFF8EC>  Amarillo claro | Presentación (Frontend) |
  |<#F0FAF0>  Verde claro    | Servicios (Backend)     |
  |<#EEF6FF>  Azul claro     | Base de Datos           |
  |<#FEF9EC>  Crema          | Servicios Externos      |
endlegend

@enduml
